<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup and device-to-device transfer, on API 31 and above. See `backup_rules.xml`
  for why the auth-token store is excluded; this file is the same decision for the newer
  platform, and both exist because the platform reads one or the other by version.

  `device-transfer` needs the exclusion as much as `cloud-backup` does, and it is the
  easier of the two to forget. A direct transfer copies the app's files to the new handset
  without any cloud in the path, which makes it feel like a lower-risk channel — but the
  keystore key does not travel with it either, so the restored ciphertext is just as
  undecryptable there as it is after a cloud restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
