<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No <uses-permission> here any more. CAMERA belongs to the two camera features and
      ACCESS_NETWORK_STATE to `:data`; each is declared in that module's own manifest and merged
      in from there, so the set of permissions the APK asks for is a consequence of the modules
      it includes rather than a list that has to be kept in step with them by hand.
    -->

    <application
        android:name=".BoilerplateApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoilerplateAndroidKotlin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
