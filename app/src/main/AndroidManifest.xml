<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No <uses-permission> here any more. CAMERA belongs to the two camera features and
      ACCESS_NETWORK_STATE to `:data`; each is declared in that module's own manifest and merged
      in from there, so the set of permissions the APK asks for is a consequence of the modules
      it includes rather than a list that has to be kept in step with them by hand.
    -->

    <!--
      android:enableOnBackInvokedCallback is the opt-in for predictive back, and without it
      every animation the back gesture is supposed to drive silently does not happen. It is
      what switches the app from the legacy KeyEvent.KEYCODE_BACK path to the
      OnBackInvokedDispatcher, and that dispatcher is the only thing that reports a gesture's
      *progress*. So with it absent: NavHost cannot seek its pop transition, a shared element
      has no seek to follow, and PredictiveBackHandler in HomeTwoPaneScreen receives a single
      completed event instead of a stream. Nothing fails — every back still navigates, one frame
      at a time — which is why this one attribute is asserted by SharedElementContractTest.

      Honoured from API 33 and on by default for apps targeting API 36+. This app is minSdk 26 /
      targetSdk 35: below 33 the platform ignores the attribute and the legacy path is used, so
      declaring it costs nothing there and the handler in HomeTwoPaneScreen still works — it just
      receives the gesture as a completion with no progress in front of it.
    -->
    <!--
      android:allowBackup stays true, and the two rules files below are what make that safe.
      Auto Backup copies the app's files off the device; the Android keystore key behind the
      encrypted auth tokens does not go with them, so a restored token store is well-formed
      and permanently undecryptable. Both files exclude it, because the platform reads
      dataExtractionRules from API 31 and fullBackupContent below that — naming only one of
      them leaves half the install base restoring tokens it can never read. See
      docs/token-storage.md, and TokenStorageContractTest, which fails the build if either
      file stops naming the store.
    -->
    <application
        android:name=".BoilerplateApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoilerplateAndroidKotlin">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's own manifest contributes an androidx.startup provider that initialises
          it eagerly with the default WorkerFactory. That factory can only build workers with
          the two-argument (Context, WorkerParameters) constructor, so UserSyncWorker — which
          takes a use case as well — would fail to instantiate at run time with
          "Could not instantiate ...UserSyncWorker" and the sync would never happen.

          Removing the initializer switches WorkManager to on-demand initialisation, where it
          asks the Application for its Configuration on first use. BoilerplateApp implements
          Configuration.Provider and supplies the HiltWorkerFactory there.

          The node is removed rather than the whole provider: androidx.startup's InitializationProvider
          is shared by every library that uses App Startup, so deleting the provider would take
          any other initializer down with it. tools:node="remove" on the meta-data leaves the
          provider in place and drops only WorkManager's entry in it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
