*.iml
.gradle
/local.properties
/.idea
.DS_Store
# Every module has one now, plus `build-logic`'s own. The bare `build/` pattern matches at any
# depth; the leading-slash form only ever matched the root project's.
build/
/captures
.externalNativeBuild
.cxx
# Signing key material, in every extension it arrives under. `*.keystore` was already here; the
# other three are the ones a PKCS #12 upload key is produced with — keytool writes `.jks` by habit
# and `.p12` by default since JDK 9, and Windows tooling writes `.pfx` for the same format. The
# upload key reaches this repository only as UPLOAD_KEYSTORE_BASE64 and is written only under
# `build/`; these patterns are what stops a decoded copy being committed by hand.
*.keystore
*.jks
*.p12
*.pfx
!debug.keystore

# The offline harness is a Python script; running it leaves bytecode next to it.
__pycache__/
